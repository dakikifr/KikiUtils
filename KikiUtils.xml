<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
  <Script file="localization.lua"/> 
  <Script file="KikiUtils.lua"/> 
  
  <Frame name="KikiUtilsFrame" hidden="false">
    <Scripts>
      <OnLoad>
        KikiUtils_OnLoad(self);
      </OnLoad>
      <OnEvent>
        KikiUtils_OnEvent(self,event,...);
      </OnEvent>
      <OnUpdate>
        --KikiUtils_Moving_OnUpdate(self,elapsed);
      </OnUpdate>
    </Scripts>
  </Frame>
  
  <GameTooltip name="KU_Tooltip" inherits="GameTooltipTemplate" parent="UIParent" hidden="true"/>
</Ui>
