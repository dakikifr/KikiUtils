<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
  <Script file="localization.lua"/> 
  <Script file="KikiUtils.lua"/> 
  
  <Frame name="KikiUtilsFrame" hidden="false">
    <Scripts>
      <OnLoad>
        KikiUtils_OnLoad(self);
      </OnLoad>
      <OnEvent>
        KikiUtils_OnEvent(self,event,...);
      </OnEvent>
      <OnUpdate>
        KikiUtils_Moving_OnUpdate(self,elapsed);
      </OnUpdate>
    </Scripts>
  </Frame>
  
  <GameTooltip name="KU_Tooltip" inherits="GameTooltipTemplate" parent="UIParent" hidden="true"/>

  <Frame name="KU_MMPingFrame" enableMouse="false" parent="UIParent">
    <Size>
      <AbsDimension x="80" y="15"/>
    </Size>
    <Anchors>
      <Anchor point="TOPRIGHT" relativeTo="MinimapCluster" relativePoint="BOTTOMRIGHT">
        <Offset>
          <AbsDimension x="-45" y="15"/>
        </Offset>
      </Anchor>
    </Anchors>
    <Layers>
      <Layer level="BACKGROUND" enableMouse="false">
        <FontString name="KU_MMPingText" inherits="GameFontNormalSmall" enableMouse="false" />
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>
        KikiUtils_MMPing_OnLoad(self);
      </OnLoad>
      <OnEvent>
        KikiUtils_MMPing_OnEvent(self,event,...);
      </OnEvent>
      <OnUpdate>
        KikiUtils_MMPing_OnUpdate(self,elapsed);
      </OnUpdate>
    </Scripts>
  </Frame>

	<Frame name="KU_TextFrame" virtual="true" enableMouse="false" setAllPoints="true">
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="$parentName" inherits="GameFontNormalSmall" justifyH="CENTER">
					<Size>
						<AbsDimension x="12" y="12"/>
					</Size>
					<Anchors>
						<Anchor point="CENTER">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				self:SetFrameLevel(self:GetParent():GetFrameLevel()+30);
			</OnLoad>
		</Scripts>
	</Frame>

</Ui>
